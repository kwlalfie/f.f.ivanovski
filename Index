<section id="listening">
  <div class="wrap">
    <div class="section-head">
      <span class="section-num">03</span>
      <h2 class="section-title">Listening</h2>
    </div>

    <!--
      SPOTIFY EMBED
      Get your own embed code from Spotify:
      1. Open the album/playlist/track in Spotify
      2. Click the "..." menu → Share → Embed playlist/album/track
      3. Copy the src URL from the iframe it gives you and paste it below,
         replacing the placeholder src.
    -->
    <div class="listening-embed">
      <iframe
        src="https://open.spotify.com/embed/album/1DFixLWuPkv3KT3TnV35m3?utm_source=generator&theme=0"
        width="100%"
        height="352"
        frameborder="0"
        allowfullscreen=""
        allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
        loading="lazy">
      </iframe>
    </div>
    <p class="listening-note">Placeholder album embed — swap the iframe src for your own album, playlist, or track link.</p>
  </div>
</section>

<section id="instagram">
  <div class="wrap">
    <div class="section-head">
      <span class="section-num">04</span>
      <h2 class="section-title">Instagram</h2>
    </div>

    <!--
      INSTAGRAM EMBEDS
      Instagram only embeds real, published posts — there's no generic placeholder embed.
      To add a real post:
      1. Open the post on instagram.com, click "..." → Embed → Copy embed code
      2. Paste the <blockquote class="instagram-media">...</blockquote> code
         in place of one of the .insta-embed-slot divs below
      3. Keep the embed.js script tag at the bottom of the page (already included)
      The slots below are placeholders until you do that.
    -->
    <div class="insta-grid">
      <div class="insta-embed-slot"><p>Instagram post embed placeholder</p></div>
      <div class="insta-embed-slot"><p>Instagram post embed placeholder</p></div>
      <div class="insta-embed-slot"><p>Instagram post embed placeholder</p></div>
    </div>
  </div>
</section>

